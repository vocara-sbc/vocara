# vim:set ft=dockerfile:
# FreeSWITCH 1.10.10 多阶段构建镜像：
# builder 阶段承载编译工具链与官方源构建，runtime 阶段仅含最小运行库与安装产物。
# 基础镜像 debian/eol:bullseye（builder）/ bullseye-slim（runtime）：
# 预装包版本与 Debian 归档冻结线一致，满足 apt build-dep 对运行库与开发包同版的要求。
#
# 在 lib/ 目录内构建，上下文为当前目录（源码树 freeswitch-1.10.10 位于上下文根）：
#   cd lib
#   docker build -f Dockerfile.freeswitch.multistage \
#     --build-arg SIGNALWIRE_TOKEN=<官方源凭证> \
#     -t registry.example.com/vocara/freeswitch:1.10.10 .

# ==================== 阶段 0：编译阶段 ====================
FROM debian/eol:bullseye AS builder

ENV BASE_DIR="/usr/local/freeswitch"
# SIGNALWIRE_TOKEN：FreeSWITCH 官方软件源访问凭证，由构建参数 --build-arg 注入
ARG SIGNALWIRE_TOKEN

# 包源统一指向阿里云 debian-archive（bullseye 归档镜像的可用镜像源）。
# 基础镜像预装的部分包来自 security 通道（gnupg/gpgv u3、liblzma u2、libudev1 u8），
# 主归档冻结线不含这些版本；security 套件有永久归档（suite 名 bullseye-security），
# 单独写入源文件，使 build-dep 的候选版本与预装包一致，依赖闭包无需降级。
# 基础镜像内尚无 ca-certificates，源地址使用 http。
RUN sed -i "s/# alias ll=/alias ll=/g" ~/.bashrc \
    && cp -a /etc/apt/sources.list /etc/apt/sources.list.bak \
    && sed -i "s@http://archive.debian.org/debian@http://mirrors.aliyun.com/debian-archive/debian@g" /etc/apt/sources.list \
    && sed -i "s@http://deb.debian.org/debian@http://mirrors.aliyun.com/debian-archive/debian@g" /etc/apt/sources.list \
    && sed -i "\@debian-security@d" /etc/apt/sources.list \
    && echo "deb http://mirrors.aliyun.com/debian-archive/debian-security bullseye-security main" \
       > /etc/apt/sources.list.d/security-archive.list

# wget、lsb-release、ca-certificates 为注册并访问官方 https 软件源的前置工具
RUN apt-get update -y && apt-get install -y wget lsb-release ca-certificates

# 注册 FreeSWITCH 官方软件源（签名密钥与源认证）
RUN wget --http-user=signalwire --http-password=${SIGNALWIRE_TOKEN} -O /usr/share/keyrings/signalwire-freeswitch-repo.gpg https://freeswitch.signalwire.com/repo/deb/debian-release/signalwire-freeswitch-repo.gpg
RUN echo "machine freeswitch.signalwire.com login signalwire password ${SIGNALWIRE_TOKEN}" > /etc/apt/auth.conf
RUN echo "deb [signed-by=/usr/share/keyrings/signalwire-freeswitch-repo.gpg] https://freeswitch.signalwire.com/repo/deb/debian-release/ `lsb_release -sc` main" > /etc/apt/sources.list.d/freeswitch.list
RUN echo "deb-src [signed-by=/usr/share/keyrings/signalwire-freeswitch-repo.gpg] https://freeswitch.signalwire.com/repo/deb/debian-release/ `lsb_release -sc` main" >> /etc/apt/sources.list.d/freeswitch.list

# glibc/openssl/perl 等核心运行库钉在 bullseye 主归档版本；
# build-dep 其余闭包由 security 归档源与预装版本对齐，无降级冲突
RUN apt-get update -y \
    && apt-get install -y --allow-downgrades \
       libc6/bullseye libssl1.1/bullseye libudev1/bullseye libsepol1/bullseye \
       perl-base/bullseye perl/bullseye perl-modules-5.32/bullseye libperl5.32/bullseye \
    && apt-get build-dep freeswitch -y

# libks、signalwire-client-c 为编译依赖，同时属于 FreeSWITCH 运行时共享库
RUN apt-get update -y && apt-get install -y libks signalwire-client-c \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ADD freeswitch-1.10.10/ /root/freeswitch-1.10.10/
# 模块裁剪与媒体栈：
# - mod_spandsp（传真/TDD）不纳入编译，呼叫中心无传真业务；
# - mod_event_socket、mod_sofia、mod_opus、mod_rtc 默认启用；
# - WebRTC 媒体栈为 mod_rtc，DTLS 1.2 由 switch_rtp 原生提供，SRTP 随 DTLS 协商。
RUN cd /root/freeswitch-1.10.10 \
    && sed -i 's|^applications/mod_spandsp|#applications/mod_spandsp|' build/modules.conf.in \
    && grep -n 'mod_spandsp\|mod_event_socket\|mod_sofia\|mod_opus\|mod_rtc' build/modules.conf.in

# 编译安装
RUN cd /root/freeswitch-1.10.10 \
    && chmod -R +x libs/ \
    && sh bootstrap.sh -j \
    && sh configure -C \
    && make -j"$(nproc)" \
    && make install

# ==================== 阶段 1：运行阶段 ====================
FROM debian/eol:bullseye-slim AS runtime

ENV BASE_DIR="/usr/local/freeswitch"
# SIGNALWIRE_TOKEN：注册 FreeSWITCH 官方软件源的访问凭证，由构建参数注入
ARG SIGNALWIRE_TOKEN

# 运行阶段同样使用阿里云 debian-archive 源；bullseye-slim 的源行含 archive.debian.org
# 与 deb.debian.org 两种写法，一并替换；安装 ca-certificates 前源地址走 http。
# security 套件归档源与 builder 阶段一致，运行库候选版本与预装包保持一致。
RUN sed -i "s/# alias ll=/alias ll=/g" ~/.bashrc \
    && cp -a /etc/apt/sources.list /etc/apt/sources.list.bak \
    && sed -i "s@http://archive.debian.org/debian@http://mirrors.aliyun.com/debian-archive/debian@g" /etc/apt/sources.list \
    && sed -i "s@http://deb.debian.org/debian@http://mirrors.aliyun.com/debian-archive/debian@g" /etc/apt/sources.list \
    && sed -i "\@debian-security@d" /etc/apt/sources.list \
    && echo "deb http://mirrors.aliyun.com/debian-archive/debian-security bullseye-security main" \
       > /etc/apt/sources.list.d/security-archive.list

# 运行库安装：
# - libks、signalwire-client-c、libsofia-sip-ua0、libspandsp4 取 FreeSWITCH 官方源；
#   sofia-sip、spandsp 的编译版本要求高于 bullseye 主归档，只能由官方源满足；
#   build-dep 经虚拟包 libspandsp-dev 解析到当前 spandsp 3.1.x（SONAME .so.4，
#   运行时包为 libspandsp4）；官方源与 builder 阶段为同一仓库，运行库与开发包同版；
# - ffmpeg（mod_av）、lua5.2（mod_lua）、libtpl、unixODBC、AMR-NB、PostgreSQL
#   客户端等取 bullseye 主归档版本，与 build-dep 解析的开发包同版；
# - 共享库的次级依赖（libavcodec 的编解码套件、sofia 的 glib 等）由 apt 自动解析。
# 官方源访问凭证与源清单在安装结束后删除，不进入最终镜像层。
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends wget lsb-release ca-certificates \
    && wget --http-user=signalwire --http-password=${SIGNALWIRE_TOKEN} \
       -O /usr/share/keyrings/signalwire-freeswitch-repo.gpg \
       https://freeswitch.signalwire.com/repo/deb/debian-release/signalwire-freeswitch-repo.gpg \
    && echo "machine freeswitch.signalwire.com login signalwire password ${SIGNALWIRE_TOKEN}" > /etc/apt/auth.conf \
    && echo "deb [signed-by=/usr/share/keyrings/signalwire-freeswitch-repo.gpg] https://freeswitch.signalwire.com/repo/deb/debian-release/ `lsb_release -sc` main" > /etc/apt/sources.list.d/freeswitch.list \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends \
       libssl1.1 libspeex1 libspeexdsp1 libcurl4 libsqlite3-0 libedit2 \
       libjpeg62-turbo libpcre3 zlib1g liblzma5 libsndfile1 libopus0 libldns3 \
       libfreetype6 ca-certificates \
       libks signalwire-client-c libsofia-sip-ua0 libspandsp4 \
       libavcodec58 libavformat58 libavutil56 libswresample3 libswscale5 \
       libtpl0 liblua5.2-0 libodbc1 libopencore-amrnb0 libpq5 \
    && rm -f /etc/apt/auth.conf /etc/apt/sources.list.d/freeswitch.list \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 安装产物：主程序、共享库、模块与默认配置。
# --from=0 按序号引用第一个构建阶段（builder），不依赖阶段名字面匹配。
COPY --from=0 /usr/local/freeswitch /usr/local/freeswitch

# libks / signalwire-client 运行库直接取自 builder 阶段，确保与编译链接的 soname 严格一致。
# 信号源运行时库统一安装在 /usr/lib。
COPY --from=0 /usr/lib/libks2.so* /usr/lib/
COPY --from=0 /usr/lib/libsignalwire_client2.so* /usr/lib/
RUN ldconfig

# 运行库完整性自检：主程序、共享库与模块不得存在缺失链接，否则构建失败
RUN MISSING=$(ldd /usr/local/freeswitch/bin/* /usr/local/freeswitch/lib/*.so* /usr/local/freeswitch/mod/*.so 2>/dev/null | grep 'not found' | sort -u) \
    && if [ -n "$MISSING" ]; then echo "MISSING LIBS:" && echo "$MISSING" && exit 1; fi

# locale：bullseye 的 glibc 2.31 内置 C.UTF-8
ENV LANG=C.UTF-8

RUN ln -sf /usr/local/freeswitch/bin/freeswitch /usr/bin/ \
    && ln -sf /usr/local/freeswitch/bin/fs_cli /usr/bin/

## 端口声明
## 8021/tcp ESL；5060/5061、5080/5081 SIP/SIPS；7443 SIP-over-WSS；
## 5070；16384-32768、64535-65535/udp RTP
EXPOSE 8021/tcp
EXPOSE 5060/tcp 5060/udp 5080/tcp 5080/udp
EXPOSE 5061/tcp 5061/udp 5081/tcp 5081/udp
EXPOSE 7443/tcp
EXPOSE 5070/udp 5070/tcp
EXPOSE 64535-65535/udp
EXPOSE 16384-32768/udp

# 文件句柄上限由容器运行参数注入，镜像内不配置 security limits。

WORKDIR $BASE_DIR/bin

CMD ["freeswitch"]
