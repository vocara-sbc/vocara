# Vocara 业务服务多阶段构建（admin / agentcenter / acd / push 共用）
#
# 每个服务独立构建、产出自有镜像，构建参数：
#   SERVICE：服务名（如 admin），决定二进制名与镜像内进程
#   PKG：    编译入口包路径（如 ./business/services/admin/cmd）
#   VERSION / GIT_COMMIT / BUILD_TIME：注入 vocara/pkg/version 的版本信息
#
# 呼叫控制服务 vocara-callctrl 使用 deploy/docker/Dockerfile.callctrl（预编译二进制交付）。
#
# 构建示例：
#   docker build -f deploy/docker/Dockerfile.backend \
#     --build-arg SERVICE=admin --build-arg PKG=./business/services/admin/cmd \
#     -t registry.example.com/vocara/vocara-admin:1.0.0 .

ARG GO_VERSION=1.22

FROM golang:${GO_VERSION}-alpine AS build

ARG SERVICE
ARG PKG

# 国内模块拉取
ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=sum.golang.google.cn \
    CGO_ENABLED=0

WORKDIR /src

RUN apk add --no-cache git

# go.work 工作区上下文：先拷贝工作区定义与全部模块源码，
# workspace 下各模块经 go.work 解析，单服务入口即可完成编译。
COPY go.work go.work.sum ./
COPY pkg/ ./pkg/
COPY contracts/ ./contracts/
COPY business/ ./business/

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME

# 只编译当前构建参数指定的服务入口
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath \
      -ldflags "-s -w \
        -X vocara/pkg/version.Version=${VERSION} \
        -X vocara/pkg/version.BuildTime=${BUILD_TIME} \
        -X vocara/pkg/version.GitCommit=${GIT_COMMIT}" \
      -o /out/vocara-${SERVICE} ${PKG}

# ---- 运行层 ----
FROM alpine:3.20

ARG SERVICE

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 vocara \
    && mkdir -p /app/logs /app/records \
    && chown -R vocara:vocara /app

COPY --from=build /out/vocara-${SERVICE} /app/vocara-${SERVICE}

WORKDIR /app
USER vocara:vocara

ENV TZ=Asia/Shanghai \
    SERVICE=${SERVICE}

# exec 形式不展开 ARG，经 sh -c 按 SERVICE 环境变量启动对应进程
ENTRYPOINT ["sh", "-c", "exec /app/vocara-${SERVICE}"]
