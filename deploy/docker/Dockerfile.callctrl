# Vocara call control service image (delivered as a prebuilt binary)
#
# The callctrl source code resides in the private core repository. This image directly uses the prebuilt binary
# bin/vocara-callctrl provided with the repository; no Go source code is compiled in the image.

FROM alpine:3.20

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME

LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}"

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 vocara \
    && mkdir -p /app/logs /app/records \
    && chown -R vocara:vocara /app

COPY bin/vocara-callctrl /app/vocara-callctrl
RUN chmod +x /app/vocara-callctrl

WORKDIR /app
USER vocara:vocara

ENV TZ=Asia/Shanghai \
    SERVICE=callctrl

ENTRYPOINT ["/app/vocara-callctrl"]
