# Vocara 呼叫控制服务镜像（预编译二进制交付）
#
# callctrl 源码位于核心私有仓库，此处直接采用随仓库提供的预编译二进制
# bin/vocara-callctrl，不在镜像内编译 Go 源码。

FROM alpine:3.20

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME

LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}"

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 vocara \
    && mkdir -p /app/logs /app/records \
    && chown -R vocara:vocara /app

COPY bin/vocara-callctrl /app/vocara-callctrl
RUN chmod +x /app/vocara-callctrl

WORKDIR /app
USER vocara:vocara

ENV TZ=Asia/Shanghai \
    SERVICE=callctrl

ENTRYPOINT ["/app/vocara-callctrl"]