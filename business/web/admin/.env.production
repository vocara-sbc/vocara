# 生产环境
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=
VITE_APP_TITLE=Vocara 呼叫中心管理系统

# WebRTC SIP（生产经 nginx /sip-ws 反代到 FS 座席侧节点；相对路径由 call store
# 按当前页面协议补全为 wss://<host>/sip-ws，避免 https 页面下 ws:// 明文被浏览器禁用）
VITE_SIP_WS_URL=/sip-ws
# JsSIP 注册域名，须与 fs-agent 的 VOCARA_FS_AGENT_DOMAIN（force-register-domain）一致
VITE_SIP_DOMAIN=192.168.100.11
# FS 分机注册密码（vars.xml 的 default_password，与后台登录密码无关）
VITE_SIP_PASSWORD=1234
