# 开发环境
# 走 vite 代理（vite.config.ts 中 /api -> http://localhost:8080，/ws -> ws://localhost:8084），
# 同源请求可避免 CORS；不要写成 http://localhost:8080，否则会缺少 /api 前缀导致 404/拒绝连接
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=
VITE_APP_TITLE=Vocara 呼叫中心管理系统

# WebRTC SIP（经 vite 代理 /sip-ws -> FS 座席侧节点 5066；https 页面下浏览器不允许 ws:// 明文，
# 相对路径由 call store 按当前页面协议补全为 wss://<host>/sip-ws）
VITE_SIP_WS_URL=/sip-ws
# /sip-ws 代理目标（FS 座席侧 WebSocket 地址）；vite.config.ts 只读此环境变量，不留硬编码 IP
VITE_SIP_PROXY_TARGET=ws://192.168.100.11:5066
# JsSIP 注册域名（与 fs-agent 的 force-register-domain 一致）
VITE_SIP_DOMAIN=192.168.100.11
# FS 分机注册密码（vars.xml 的 default_password），与后台登录密码无关
VITE_SIP_PASSWORD=1234
